datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS (100% Verified against Mongoose Models)
// ==========================================

enum UserRole {
  owner
  admin
  manager
  user
}

enum TaskStatus {
  todo
  in_progress @map("in-progress")
  completed
}

enum TaskPriority {
  low
  medium
  high
}

enum ProjectProvider {
  workcomposer
  jira
  asana
}

enum IntegrationProvider {
  jira
  asana
  slack
  keka
  bamboohr
  storage
}

enum SessionType {
  work
  break
}

enum SessionSource {
  tracking
  manual
}

enum TimerStatus {
  running
  stopped
}

enum ProductivityLevel {
  productive
  neutral
  unproductive
  blacklisted
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum SubscriptionPlan {
  standard
  premium
  enterprise
}

enum BillingCycle {
  monthly
  annual
}

enum SubscriptionStatus {
  active
  trial
  suspended
  cancelled
}

enum InvoiceStatus {
  paid
  pending
  failed
  refunded
}

enum AuditCategory {
  Users
  Teams
  Roles
  Desktop_App    @map("Desktop App")
  Organization
  Settings
  Billing
  Storage
  Projects
  Tasks
  HR_Leave_Types @map("HR Leave Types")
  Devices
}

enum ReportType {
  attendance_overview @map("attendance-overview")
  attendance_detailed @map("attendance-detailed")
  productivity
  usage
  project_user        @map("project-user")
  project
  manual_work_time    @map("manual-work-time")
  manual_break_time   @map("manual-break-time")
  removed_time        @map("removed-time")
  daily_work          @map("daily-work")
}

enum ReportStatus {
  processing
  done
  failed
}

enum ReportDeliveryStatus {
  PENDING
  CLAIMED
  SENT
  FAILED
  CANCELLED
}

enum DesktopSyncStatus {
  synced
  syncing
  offline
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                      String             @id @db.VarChar(24)
  firstName               String             @map("first_name")
  lastName                String             @map("last_name")
  email                   String             @unique
  twoFactorCode           String?            @map("two_factor_code")
  twoFactorExpires        DateTime?          @map("two_factor_expires") @db.Timestamptz(3)
  jiraAccountId           String?            @map("jira_account_id")
  asanaAccountId          String?            @map("asana_account_id")
  bambooHREmployeeId      String?            @map("bamboohr_employee_id")
  slackUserId             String?            @map("slack_user_id")
  avatar                  String             @default("")
  organizationId          String             @map("organization_id") @db.VarChar(24)
  role                    UserRole           @default(user)
  reportTimezone          String?            @default("Browser timezone") @map("report_timezone")
  roleRef                 String?            @map("role_ref") @db.VarChar(24)
  teamId                  String?            @map("team_id") @db.VarChar(24)
  reportTeamId            String?            @map("report_team_id") @db.VarChar(24)
  managerId               String?            @map("manager_id") @db.VarChar(24)
  weeklyReport            Boolean            @default(true) @map("weekly_report")
  dailyReport             Boolean            @default(false) @map("daily_report")
  breakStartTime          DateTime?          @map("break_start_time") @db.Timestamptz(3)
  password                String?
  googleId                String?            @map("google_id")
  microsoftId             String?            @map("microsoft_id")
  appleId                 String?            @map("apple_id")
  authProvider            String             @default("local") @map("auth_provider")
  isVerified              Boolean            @default(false) @map("is_verified")
  isArchived              Boolean            @default(false) @map("is_archived")
  verificationToken       String?            @map("verification_token")
  verificationTokenExpire DateTime?          @map("verification_token_expire") @db.Timestamptz(3)
  resetToken              String?            @map("reset_token")
  resetTokenExpire        DateTime?          @map("reset_token_expire") @db.Timestamptz(3)
  lastDailyWarningEmail   DateTime?          @map("last_daily_warning_email") @db.Timestamptz(3)
  lastWeeklyWarningEmail  DateTime?          @map("last_weekly_warning_email") @db.Timestamptz(3)
  workSpaceId             String?            @map("workspace_id") @db.VarChar(24)
  appUpdateSettings       Json?              @map("app_update_settings")
  trackingSettings        Json?              @map("tracking_settings")
  screenCaptureSettings   Json?              @map("screen_capture_settings")
  manualTimeSettings      Json?              @map("manual_time_settings")
  shiftSettings           Json?              @map("shift_settings")
  notificationSettings    Json?              @map("notification_settings")
  emailReportSettings     Json?              @map("email_report_settings")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  organization            Organization       @relation("OrgUsers", fields: [organizationId], references: [id], onDelete: Cascade)
  team                    Team?              @relation("UserTeam", fields: [teamId], references: [id], onDelete: SetNull)
  reportTeam              Team?              @relation("UserReportTeam", fields: [reportTeamId], references: [id], onDelete: SetNull)
  manager                 User?              @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates            User[]             @relation("UserManager")
  managerLinks            UserManagerAssignment[] @relation("UserAssignedManagers")
  subordinateLinks        UserManagerAssignment[] @relation("ManagerAssignedUsers")
  customRole              Role?              @relation(fields: [roleRef], references: [id], onDelete: SetNull)
  devices                 UserDevice[]
  refreshTokens           UserRefreshToken[]
  assignedTasks           Task[]             @relation("TaskAssignedTo")
  createdTasks            Task[]             @relation("TaskAssignedBy")
  deletedTasks            Task[]             @relation("TaskDeletedBy")
  sessions                Session[]
  timers                  Timer[]
  screenshots             Screenshot[]
  activities              Activity[]
  intelligenceObservations IntelligenceObservation[]
  appUsages               AppUsage[]
  usageLogs               UsageLog[]
  projectTrackings        ProjectTracking[]
  attendances             Attendance[]
  manualRequests          ManualTimeRequest[] @relation("ManualRequestedBy")
  approvedRequests        ManualTimeRequest[] @relation("ManualApprovedBy")
  comments                Comment[]
  notifications           Notification[]     @relation("NotificationRecipient")
  auditLogs               AuditLog[]         @relation("AuditPerformedBy")
  projectMemberships      ProjectUser[]
  createdTeams            Team[]             @relation("TeamCreatedBy")
  createdProjects         Project[]          @relation("ProjectCreatedBy")
  createdApiKeys          ApiKey[]           @relation("ApiKeyCreatedBy")
  sentInvites             Invite[]           @relation("InviteSentBy")
  reports                 Report[]
  syncStatus              SyncStatus?
  emailChanges            EmailChange[]
  locations               Location[]
  ownedOrganizations      Organization[]     @relation("OrgOwner")

  @@index([organizationId])
  @@index([teamId])
  @@index([email])
  @@map("users")
}

model UserManagerAssignment {
  id             String       @id @db.VarChar(24)
  organizationId String       @map("organization_id") @db.VarChar(24)
  userId         String       @map("user_id") @db.VarChar(24)
  managerId      String       @map("manager_id") @db.VarChar(24)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("UserAssignedManagers", fields: [userId], references: [id], onDelete: Cascade)
  manager        User         @relation("ManagerAssignedUsers", fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([userId, managerId])
  @@index([organizationId, managerId])
  @@index([userId])
  @@map("user_manager_assignments")
}

model UserDevice {
  id           String    @id @db.VarChar(24)
  userId       String    @map("user_id") @db.VarChar(24)
  deviceId     String    @map("device_id")
  ip           String?
  location     String?
  platform     String?
  appVersion   String?   @map("app_version")
  hostname     String?
  loginTime    DateTime  @default(now()) @map("login_time") @db.Timestamptz(3)
  lastSync     DateTime  @default(now()) @map("last_sync") @db.Timestamptz(3)
  isOnline     Boolean   @default(false) @map("is_online")
  isTracking   Boolean   @default(false) @map("is_tracking")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model UserRefreshToken {
  id        String   @id @db.VarChar(24)
  userId    String   @map("user_id") @db.VarChar(24)
  token     String   @unique
  deviceId  String?  @map("device_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_refresh_tokens")
}

model Organization {
  id                 String                @id @db.VarChar(24)
  name               String                @unique
  ownerId            String?               @map("owner_id") @db.VarChar(24)
  logo               String                @default("")
  timezone           String                @default("Asia/Kolkata")

  twoFactor          Json?                 @map("two_factor")
  appUpdates         Json?                 @map("app_updates")
  emailReports       Json?                 @map("email_reports")
  taskManagement     Json?                 @map("task_management")
  notifications      Json?                 @map("notifications")

  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner              User?                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  users              User[]                @relation("OrgUsers")
  teams              Team[]
  projects           Project[]
  tasks              Task[]
  roles              Role[]
  apiKeys            ApiKey[]
  apiLogs            ApiLog[]
  auditLogs          AuditLog[]
  billingProfile     BillingProfile?
  subscription       Subscription?
  invoices           Invoice[]
  paymentMethod      PaymentMethod?
  trackingSettings   TimeTrackingSettings?
  appClassifications AppClassification[]
  integrations       Integration[]
  invites            Invite[]
  attendances        Attendance[]
  locations          Location[]
  manualTimeRequests ManualTimeRequest[]
  notificationsList  Notification[]
  intelligenceObservations IntelligenceObservation[]
  managerAssignments UserManagerAssignment[]

  @@map("organizations")
}

model Team {
  id             String       @id @db.VarChar(24)
  name           String
  description    String       @default("")
  organizationId String       @map("organization_id") @db.VarChar(24)
  createdById    String?      @map("created_by_id") @db.VarChar(24)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members        User[]       @relation("UserTeam")
  reportMembers  User[]       @relation("UserReportTeam")
  invites        Invite[]

  @@map("teams")
}

model Role {
  id               String       @id @db.VarChar(24)
  organizationId   String       @map("organization_id") @db.VarChar(24)
  name             String
  description      String       @default("")
  permissions      String[]
  reportAccess     String       @default("none") @map("report_access")
  screenshotAccess String       @default("none") @map("screenshot_access")
  isSystem         Boolean      @default(false) @map("is_system")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users            User[]

  @@map("roles")
}

model Project {
  id             String            @id @db.VarChar(24)
  name           String
  jiraProjectId  String?           @map("jira_project_id")
  jiraProjectKey String?           @map("jira_project_key")
  asanaProjectId String?           @map("asana_project_id")
  asanaWebhookId String?           @map("asana_webhook_id")
  provider       ProjectProvider   @default(workcomposer)
  teams          String[]
  organizationId String            @map("organization_id") @db.VarChar(24)
  createdById    String?           @map("created_by_id") @db.VarChar(24)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks          Task[]
  members        ProjectUser[]
  sessions       Session[]
  timers         Timer[]
  usageLogs      UsageLog[]
  projectTrackings ProjectTracking[]
  screenshots    Screenshot[]
  activities     Activity[]
  manualRequests ManualTimeRequest[]

  @@index([organizationId])
  @@map("projects")
}

model ProjectUser {
  projectId String   @map("project_id") @db.VarChar(24)
  userId    String   @map("user_id") @db.VarChar(24)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_users")
}

model Task {
  id             String              @id @db.VarChar(24)
  title          String
  description    String?
  status         TaskStatus          @default(todo)
  priority       TaskPriority        @default(medium)
  projectId      String?             @map("project_id") @db.VarChar(24)
  jiraIssueId    String?             @map("jira_issue_id")
  jiraIssueKey   String?             @map("jira_issue_key")
  asanaTaskId    String?             @map("asana_task_id")
  provider       String              @default("local")
  assignedToId   String?             @map("assigned_to_id") @db.VarChar(24)
  assignedById   String?             @map("assigned_by_id") @db.VarChar(24)
  dueDate        DateTime?           @map("due_date") @db.Timestamptz(3)
  organizationId String              @map("organization_id") @db.VarChar(24)
  deleted        Boolean             @default(false)
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?             @map("deleted_by_id") @db.VarChar(24)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  project        Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User?               @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy     User?               @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  deletedBy      User?               @relation("TaskDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  comments       Comment[]
  timers         Timer[]
  sessions       Session[]
  usageLogs      UsageLog[]
  projectTrackings ProjectTracking[]
  screenshots    Screenshot[]
  activities     Activity[]
  manualRequests ManualTimeRequest[]

  @@index([projectId])
  @@index([organizationId])
  @@index([assignedToId])
  @@index([deleted])
  @@map("tasks")
}

model Session {
  id          String        @id @db.VarChar(24)
  userId      String        @map("user_id") @db.VarChar(24)
  projectId   String?       @map("project_id") @db.VarChar(24)
  taskId      String?       @map("task_id") @db.VarChar(24)
  startTime   DateTime?     @map("start_time") @db.Timestamptz(3)
  endTime     DateTime?     @map("end_time") @db.Timestamptz(3)
  duration    Float?
  screenshots Int?
  date        String?
  team        String        @default("Default team")
  type        SessionType   @default(work)
  source      SessionSource @default(tracking)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([startTime, endTime])
  @@map("sessions")
}

model Timer {
  id        String      @id @db.VarChar(24)
  userId    String      @map("user_id") @db.VarChar(24)
  projectId String?     @map("project_id") @db.VarChar(24)
  taskId    String?     @map("task_id") @db.VarChar(24)
  startTime DateTime?   @map("start_time") @db.Timestamptz(3)
  endTime   DateTime?   @map("end_time") @db.Timestamptz(3)
  duration  Float       @default(0)
  status    TimerStatus @default(stopped)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("timers")
}

model Screenshot {
  id            String    @id @db.VarChar(24)
  userId        String    @map("user_id") @db.VarChar(24)
  projectId     String?   @map("project_id") @db.VarChar(24)
  taskId        String?   @map("task_id") @db.VarChar(24)
  imageUrl      String    @map("image_url")
  publicId      String    @map("public_id")
  capturedAt    DateTime  @default(now()) @map("captured_at") @db.Timestamptz(3)
  appName       String    @default("") @map("app_name")
  windowTitle   String    @default("") @map("window_title")
  keyPresses    Int       @default(0) @map("key_presses")
  mouseClicks   Int       @default(0) @map("mouse_clicks")
  mouseMoves    Int       @default(0) @map("mouse_moves")
  activityScore Float     @default(0) @map("activity_score")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, capturedAt])
  @@map("screenshots")
}

model Activity {
  id          String   @id @db.VarChar(24)
  userId      String   @map("user_id") @db.VarChar(24)
  projectId   String?  @map("project_id") @db.VarChar(24)
  taskId      String?  @map("task_id") @db.VarChar(24)
  date        String
  keyPresses  Int      @default(0) @map("key_presses")
  mouseClicks    Int      @default(0) @map("mouse_clicks")
  mouseMoves     Int      @default(0) @map("mouse_moves")
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(128)
  eventTimestamp DateTime? @map("event_timestamp") @db.Timestamptz(3)
  telemetry      Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, eventTimestamp])
  @@map("activities")
}

model IntelligenceObservation {
  id             String       @id @db.VarChar(64)
  organizationId String       @map("organization_id") @db.VarChar(24)
  employeeId     String       @map("employee_id") @db.VarChar(24)
  category       String       @db.VarChar(32)
  type           String       @db.VarChar(64)
  windowStart    DateTime     @map("window_start") @db.Timestamptz(3)
  windowEnd      DateTime     @map("window_end") @db.Timestamptz(3)
  status         String       @db.VarChar(20)
  evidence       Json         @db.JsonB
  ruleId         String       @map("rule_id") @db.VarChar(64)
  ruleVersion    String       @map("rule_version") @db.VarChar(16)
  explanation    String       @db.Text
  limitations    String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId, windowStart])
  @@index([employeeId, windowStart, windowEnd])
  @@map("intelligence_observations")
}

model AppUsage {
  id          String   @id @db.VarChar(24)
  userId      String   @map("user_id") @db.VarChar(24)
  appName     String   @map("app_name")
  windowTitle String   @default("") @map("window_title")
  duration    Float    @default(0)
  date        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("app_usages")
}

model UsageLog {
  id          String    @id @db.VarChar(24)
  userId      String    @map("user_id") @db.VarChar(24)
  projectId   String?   @map("project_id") @db.VarChar(24)
  taskId      String?   @map("task_id") @db.VarChar(24)
  appName     String    @map("app_name")
  windowTitle String    @default("") @map("window_title")
  startTime   DateTime  @map("start_time") @db.Timestamptz(3)
  endTime     DateTime  @map("end_time") @db.Timestamptz(3)
  duration    Float     @default(0)
  date        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("usage_logs")
}

model ProjectTracking {
  id        String   @id @db.VarChar(24)
  userId    String   @map("user_id") @db.VarChar(24)
  projectId String   @map("project_id") @db.VarChar(24)
  taskId    String?  @map("task_id") @db.VarChar(24)
  startTime DateTime @map("start_time") @db.Timestamptz(3)
  endTime   DateTime @map("end_time") @db.Timestamptz(3)
  duration  Float    @default(0)
  date      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, projectId, date])
  @@map("project_trackings")
}

model Attendance {
  id             String       @id @db.VarChar(24)
  userId         String       @map("user_id") @db.VarChar(24)
  organizationId String       @map("organization_id") @db.VarChar(24)
